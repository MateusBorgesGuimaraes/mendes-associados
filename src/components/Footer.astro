---
import Logo from "./ui/Logo.astro";

import PhoneFooter from "../icons/PhoneFooter.svg";
import EmailFooter from "../icons/EmailFooter.svg";
import LocaleFooter from "../icons/LocaleFooter.svg";

const year = new Date().getFullYear();
---

<footer class="bg-navy">
    <!-- PARTE DE CIMA -->
    <div class="px-12 pt-12 flex items-center justify-between">
        <div class="flex flex-col gap-6">
            <Logo variant="dark" />
            <p class="max-w-[27ch] text-text-subtle text-sm">
                Assessoria jurídica estratégica para pessoas e empresas desde
                2012. Atuamos em São Paulo com foco em resultados concretos.
            </p>
            <div
                class="border border-navy-mid py-2.5 px-4 flex gap-2 items-center self-start"
            >
                <span class="bg-gold rounded-full w-3 h-3"></span>
                <p class="text-text-subtle text-sm">
                    OAB/SP 000.000 — Inscrito
                </p>
            </div>
        </div>
        <div>
            <h4 class="text-sm text-gold font-medium uppercase mb-6">
                Áreas de atuação
            </h4>
            <ul class="flex flex-col gap-3">
                <li>
                    <a class="text-sm text-text-subtle" href="/"
                        >Direito Civil</a
                    >
                </li>
                <li>
                    <a class="text-sm text-text-subtle" href="/"
                        >Direito Trabalhista</a
                    >
                </li>
                <li>
                    <a class="text-sm text-text-subtle" href="/"
                        >Direito Empresarial</a
                    >
                </li>
                <li>
                    <a class="text-sm text-text-subtle" href="/"
                        >Direito Imobiliário</a
                    >
                </li>
                <li>
                    <a class="text-sm text-text-subtle" href="/"
                        >Direito de Família</a
                    >
                </li>
            </ul>
        </div>

        <div>
            <h4 class="text-sm text-gold font-medium uppercase mb-6">
                Escritório
            </h4>
            <ul class="flex flex-col gap-3">
                <li>
                    <a class="text-sm text-text-subtle" href="/">Sobre nós</a>
                </li>
                <li>
                    <a class="text-sm text-text-subtle" href="/">Nossa equipe</a
                    >
                </li>
                <li>
                    <a class="text-sm text-text-subtle" href="/"
                        >Blog jurídico</a
                    >
                </li>
                <li>
                    <a class="text-sm text-text-subtle" href="/"
                        >Casos de sucesso</a
                    >
                </li>
                <li>
                    <a class="text-sm text-text-subtle" href="/">Contato</a>
                </li>
            </ul>
        </div>

        <div>
            <h4 class="text-sm text-gold font-medium uppercase mb-6">
                atendimento
            </h4>
            <ul class="flex flex-col gap-3">
                <li class="flex flex-col gap-2">
                    <p
                        class="text-sm text-text-light font-semibold tracking-wider"
                    >
                        Seg – Sex
                    </p>
                    <p class="text-sm text-text-subtle">9h às 18h</p>
                </li>

                <li class="flex flex-col gap-2">
                    <p
                        class="text-sm text-text-light font-semibold tracking-wider"
                    >
                        Sábado
                    </p>
                    <p class="text-sm text-text-subtle">9h às 13h</p>
                </li>

                <li class="flex flex-col gap-2">
                    <p
                        class="text-sm text-text-light font-semibold tracking-wider"
                    >
                        Av. Paulista, 1.000
                    </p>
                    <p class="text-sm text-text-subtle">
                        12º andar — Bela Vista
                    </p>
                    <p class="text-sm text-text-subtle">São Paulo, SP</p>
                </li>
            </ul>
        </div>
    </div>
    <!-- PARTE DO MEIO -->
    <div class="mt-12 border-y border-navy-mid px-12 grid grid-cols-3">
        <div class="flex gap-4 items-center py-6 border-r border-navy-mid">
            <div
                class="border border-navy-mid p-3 flex items-center justify-center rounded-full"
            >
                <PhoneFooter class="text-text-subtle" />
            </div>
            <div class="flex flex-col gap-1.5">
                <p
                    class="text-text-subtle text-sm font-medium uppercase tracking-wider"
                >
                    TELEFONE
                </p>
                <p class="text-sm text-text-light">(11) 3000-0000</p>
            </div>
        </div>

        <div
            class="flex gap-4 items-center py-6 border-r border-navy-mid px-12"
        >
            <div
                class="border border-navy-mid p-3 flex items-center justify-center rounded-full"
            >
                <EmailFooter class="text-text-subtle" />
            </div>
            <div class="flex flex-col gap-1.5">
                <p
                    class="text-text-subtle text-sm font-medium uppercase tracking-wider"
                >
                    email
                </p>
                <p class="text-sm text-text-light">
                    contato@mendesadvogados.com.br
                </p>
            </div>
        </div>

        <div class="flex gap-4 items-center py-6 px-12">
            <div
                class="border border-navy-mid p-3 flex items-center justify-center rounded-full"
            >
                <LocaleFooter class="text-text-subtle" />
            </div>
            <div class="flex flex-col gap-1.5">
                <p
                    class="text-text-subtle text-sm font-medium uppercase tracking-wider"
                >
                    Localização
                </p>
                <p class="text-sm text-text-light">Av. Paulista, 1.000 — SP</p>
            </div>
        </div>
    </div>
    <!-- PARTE DO COPYRIGTH -->
    <div
        class="px-12 py-6 flex items-center justify-between text-sm text-text-subtle"
    >
        <p>© {year} Mendes & Associados — Todos os direitos reservados</p>
        <ul class="flex items-center gap-6">
            <li>Política de privacidade</li>
            <li class="bg-text-subtle rounded-full w-1.5 h-1.5"></li>
            <li>Termos de usoe</li>
            <li class="bg-text-subtle rounded-full w-1.5 h-1.5"></li>
            <li>LinkedIn</li>
            <li class="bg-text-subtle rounded-full w-1.5 h-1.5"></li>
            <li>Instagram</li>
        </ul>
    </div>
</footer>
