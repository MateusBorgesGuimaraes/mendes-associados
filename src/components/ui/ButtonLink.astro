---
interface Props {
    href: string;
    variant?: "nav" | "gold";
    size?: "md" | "sm";
    class?: string;
}

const { href, variant = "nav", class: className, size = "md" } = Astro.props;
---

<a
    href={href}
    class={`inline-flex items-center justify-center px-6 py-3 uppercase transition
${
    variant === "nav"
        ? "bg-navy hover:bg-navy-mid text-white"
        : "bg-gold-light hover:bg-gold text-navy"
}
${size === "md" ? "px-6 py-3 text-base" : "px-4 py-2 text-xs"}

${className}`}
>
    <slot />
</a>
