---
interface Props {
    href: string;
    variant?: "nav" | "gold";
    class?: string;
}

const { href, variant = "nav", class: className } = Astro.props;
---

<a
    href={href}
    class={`inline-flex items-center justify-center px-6 py-3 uppercase transition
${
    variant === "nav"
        ? "bg-navy hover:bg-navy-mid text-white"
        : "bg-gold-light hover:bg-gold text-navy"
} ${className}`}
>
    <slot />
</a>
