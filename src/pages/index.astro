---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import Indicator from "../components/ui/Indicator.astro";
import ListArrow from "../icons/ListArrow.svg";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");

const fourLast = allPosts.slice(0, 4);
---

<Base title="Inicio" navVariant="home">
    <!-- HERO SECTION -->
    <section class="grid grid-cols-2 h-screen">
        <div class="flex flex-col h-screen">
            <Header variant="home" />
            <div class="px-12 flex flex-col flex-1 justify-center gap-6">
                <span class="dest">Advocacia especializada — SP</span>
                <h1 class="title">
                    Direito com <br /><span class="italicGold">precisão</span
                    ><br /> e propósito.
                </h1>
                <p class="largeP max-w-110">
                    Assessoria jurídica estratégica para pessoas e empresas que
                    precisam de soluções concretas, não promessas.
                </p>
                <ButtonLink href="#" class="max-w-57.5"
                    >AGENDAR CONSULTA</ButtonLink
                >
                <Indicator>Nossas áreas</Indicator>
            </div>
        </div>
        <div class="bg-navy px-12 flex flex-col h-screen">
            <div class="flex flex-col flex-1 justify-center gap-6">
                <span class="dest2">Áreas de atuação</span>
                <ul>
                    <li
                        class="border-b border-t border-navy-mid text-text-light font-serif text-xl py-4 flex justify-between items-center"
                    >
                        Direito Civil

                        <ListArrow />
                    </li>
                    <li
                        class="border-b border-t border-navy-mid text-text-light font-serif text-xl py-4 flex justify-between items-center"
                    >
                        Direito Trabalhista

                        <ListArrow />
                    </li>
                    <li
                        class="border-b border-t border-navy-mid text-text-light font-serif text-xl py-4 flex justify-between items-center"
                    >
                        Direito Empresarial

                        <ListArrow />
                    </li>
                    <li
                        class="border-b border-t border-navy-mid text-text-light font-serif text-xl py-4 flex justify-between items-center"
                    >
                        Direito Imobiliário

                        <ListArrow />
                    </li>
                    <li
                        class="border-b border-t border-navy-mid text-text-light font-serif text-xl py-4 flex justify-between items-center"
                    >
                        Direito de Família

                        <ListArrow />
                    </li>
                </ul>
            </div>

            <div class="flex items-center justify-center pb-12">
                <div
                    class="flex flex-col items-center justify-center gap-6 px-6 border-r border-navy-mid"
                >
                    <p class="font-serif text-5xl text-gold-light">12+</p>
                    <p class="text-text-subtle uppercase">ANOS DE ATUAÇÃO</p>
                </div>

                <div
                    class="flex flex-col items-center gap-6 px-6 border-r border-navy-mid"
                >
                    <p class="font-serif text-5xl text-gold-light">840</p>
                    <p class="text-text-subtle uppercase">Casos concluídos</p>
                </div>

                <div class="flex flex-col items-center gap-6 px-6">
                    <p class="font-serif text-5xl text-gold-light">98%</p>
                    <p class="text-text-subtle uppercase">
                        Clientes satisfeitos
                    </p>
                </div>
            </div>
        </div>
    </section>
    <!-- QUALITY SECTION -->
    <section class="border-t border-b border-border grid grid-cols-3">
        <div class="flex flex-col gap-3 py-8 border-r border-border px-12">
            <span class="font-serif text-2xl text-gold">01</span>
            <h2 class="font-serif text-3xl text-navy">
                Atendimento <span class="italic">personalizado</span>
            </h2>
            <p class="text-base text-text-muted">
                Cada caso recebe atenção exclusiva. Você fala diretamente com o
                advogado responsável, sem intermediários.
            </p>
        </div>

        <div class="flex flex-col gap-3 py-8 border-r border-border px-12">
            <span class="font-serif text-2xl text-gold">02</span>
            <h2 class="font-serif text-3xl text-navy">
                Estratégia <span class="italic">orientada</span> a resultado
            </h2>
            <p class="text-base text-text-muted">
                Análise criteriosa do seu caso antes de qualquer ação. Clareza
                sobre riscos, prazos e expectativas reais.
            </p>
        </div>

        <div class="flex flex-col gap-3 py-8 px-12">
            <span class="font-serif text-2xl text-gold">03</span>
            <h2 class="font-serif text-3xl text-navy">
                Transparência <span class="italic">total</span>
            </h2>
            <p class="text-base text-text-muted">
                Honorários claros desde a primeira conversa. Sem surpresas no
                meio do processo.
            </p>
        </div>
    </section>
    <!-- RECENT ARTICLES SECTION -->
    <section class="bg-cream-mid">
        <div class="py-12 px-12">
            <h2 class="font-serif text-3xl text-navy self-start mb-8">
                Artigos & <span class="italic text-gold">insights</span>
            </h2>
            <div class="grid grid-cols-[28fr_17fr_17fr_17fr_17fr] gap-0.5">
                {
                    fourLast &&
                        fourLast.map((fl, i) =>
                            i === 0 ? (
                                <div class="bg-navy p-6 flex flex-col justify-between gap-8">
                                    <span class="text-base text-text-subtle uppercase">
                                        {fl.data.category}
                                    </span>

                                    <a
                                        href={`/blog/${fl.id}`}
                                        class="text-2xl font-serif text-white transition hover:text-gold-light"
                                    >
                                        {fl.data.title}
                                    </a>

                                    <span class="text-base text-text-subtle">
                                        {fl.data.author} - {fl.data.readTime} de
                                        leitura
                                    </span>
                                </div>
                            ) : (
                                <div class="bg-cream p-6 flex flex-col gap-8 justify-between">
                                    <span class="text-base text-gold uppercase">
                                        {fl.data.category}
                                    </span>

                                    <a
                                        href={`/blog/${fl.id}`}
                                        class="text-xl font-serif text-navy transition hover:text-gold"
                                    >
                                        {fl.data.title}
                                    </a>

                                    <span class="text-base text-text-muted">
                                        {fl.data.author} - {fl.data.readTime} de
                                        leitura
                                    </span>
                                </div>
                            ),
                        )
                }

                <div class="flex items-center justify-center">
                    <Indicator>Todos os artigos</Indicator>
                </div>
            </div>
        </div>
    </section>
    <!-- CTA SECTION -->
    <section class="py-12 mx-auto justify-center flex items-center gap-100">
        <div class="flex flex-col gap-2">
            <span class="dest">Agende uma consulta</span>
            <h1 class="title">
                Seu caso merece <br /> atenção <span class="italicGold"
                    >especializada</span
                >.
            </h1>
            <p class="largeP">
                A primeira conversa é gratuita. Em 30 minutos você entende seus <br
                /> direitos, os caminhos possíveis e o que esperar do processo.
            </p>
        </div>
        <div class="flex flex-col gap-4">
            <ButtonLink href="#" class="max-w-57.5"
                >CONSULTA GRATUTIRA</ButtonLink
            >
            <Indicator>Ou envie uma mensagem</Indicator>
        </div>
    </section>
</Base>
