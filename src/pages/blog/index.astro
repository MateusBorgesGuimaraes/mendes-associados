---
import Base from "../../layouts/Base.astro";
import CustomSearch from "../../components/form/CustomSearch.astro";
import ButtonLink from "../../components/ui/ButtonLink.astro";
import CardArticle from "../../components/ui/CardArticle.astro";

interface Articles {
    href: string;
    category: string;
    title: string;
    readingTime: string;
    author: string;
    date: string;
}

const articlesMock: Articles[] = [
    {
        href: "/",
        category: "Civil",
        title: "Usucapião urbana: requisitos e como dar entrada no processo",
        readingTime: "5 min de leitura",
        author: "Dra. Ana Souza",
        date: "8 jan 2024",
    },
    {
        href: "/",
        category: "Empresarial",
        title: "Contrato social: erros comuns que colocam sua empresa em risco",
        readingTime: "6 min de leitura",
        author: "Dr. Carlos Mendes",
        date: "2 jan 2024",
    },
    {
        href: "/",
        category: "Trabalhista",
        title: "Demissão por justa causa: quando é válida e como contestar",
        readingTime: "7 min de leitura",
        author: "Dra. Ana Souza",
        date: "28 dez 2023",
    },
    {
        href: "/",
        category: "Imobiliário",
        title: "Distrato imobiliário: o que você tem direito ao cancelar um contrato",
        readingTime: "5 min de leitura",
        author: "Dr. Rafael Faria",
        date: "18 dez 2023",
    },
    {
        href: "/",
        category: "Família",
        title: "Guarda compartilhada: como funciona na prática e o que diz a lei",
        readingTime: "6 min de leitura",
        author: "Dra. Ana Souza",
        date: "10 dez 2023",
    },
    {
        href: "/",
        category: "Empresarial",
        title: "LGPD para pequenas empresas: o mínimo que você precisa fazer",
        readingTime: "8 min de leitura",
        author: "Dr. Rafael Faria",
        date: "4 dez 2023",
    },
];
---

<Base title="Blog">
    <section class="bg-navy flex justify-between items-center px-12 py-12">
        <div>
            <div class="flex flex-col flex-1 justify-center gap-6">
                <div class="dest">
                    <span class="text-gold-light">Blog jurídico </span>
                </div>
                <h1 class="title text-text-light">
                    Artigos &<span class="italicGold text-gold-light">
                        insights</span
                    >.
                </h1>
                <p class="largeP max-w-110 text-text-subtle">
                    Conteúdo jurídico direto, sem juridiquês. Escrito pelos
                    advogados do escritório para ajudar você a entender seus
                    direitos.
                </p>
            </div>
        </div>
        <div class="flex gap-8">
            <div class="flex flex-col items-center gap-3">
                <p class="text-text-light text-[48px] font-serif">48</p>
                <p class="text-text-subtle uppercase">Artigos</p>
            </div>
            <div class="flex flex-col items-center gap-3">
                <p class="text-text-light text-[48px] font-serif">12</p>
                <p class="text-text-subtle uppercase">Paginas</p>
            </div>
            <div class="flex flex-col items-center gap-3">
                <p class="text-text-light text-[48px] font-serif">5</p>
                <p class="text-text-subtle uppercase">Categorias</p>
            </div>
        </div>
    </section>

    <!-- FILTRO -->
    <section class="border-b border-border flex item-center justify-between">
        <div class="px-12 flex gap-8">
            <button
                class="border-b-2 border-transparent py-8 px-5 cursor-pointer transition hover:border-b-gold hover:text-navy"
                >Todos</button
            >
            <button
                class="border-b-2 border-transparent py-8 px-5 cursor-pointer transition hover:border-b-gold hover:text-navy"
                >Civil</button
            >
            <button
                class="border-b-2 border-transparent py-8 px-5 cursor-pointer transition hover:border-b-gold hover:text-navy"
                >Trabalhista</button
            >
            <button
                class="border-b-2 border-transparent py-8 px-5 cursor-pointer transition hover:border-b-gold hover:text-navy"
                >Empresarial</button
            >
            <button
                class="border-b-2 border-transparent py-8 px-5 cursor-pointer transition hover:border-b-gold hover:text-navy"
                >Imobiliario</button
            >
            <button
                class="border-b-2 border-transparent py-8 px-5 cursor-pointer transition hover:border-b-gold hover:text-navy"
                >Familia</button
            >
        </div>

        <div class="px-12 py-8">
            <CustomSearch placeholder="Buscar artigos" />
        </div>
    </section>

    <!-- Destaques -->

    <div class="bg-cream-mid py-12 border-b border-border">
        <p class="dest mb-6 mx-12">destaque</p>

        <div class="mx-12 grid grid-cols-2">
            <div class="bg-navy px-12 py-16 flex flex-col gap-6">
                <p class="dest">Direito Trabalhista</p>
                <h1 class="text-4xl font-serif text-text-light">
                    O que muda com a reforma trabalhista para contratos
                    intermitentes em 2024
                </h1>
                <p class="text-text-subtle">
                    Novas decisões do TST e alterações regulatórias mudam o
                    cenário para trabalhadores e empregadores que utilizam esse
                    modelo contratual.
                </p>
                <div class="flex items-center gap-6 my-6">
                    <div class="flex gap-2 items-center">
                        <span
                            class="rounded-full bg-navy-mid p-3 font-serif text-text-light"
                            >CM</span
                        >
                        <p class="text-text-light">Dr. Carlos Mendes</p>
                    </div>
                    <span class="bg-text-subtle rounded-full w-1.5 h-1.5"
                    ></span>
                    <p class="text-text-subtle">15 jan 2024</p>
                    <span class="bg-text-subtle rounded-full w-1.5 h-1.5"
                    ></span>
                    <p class="text-text-subtle">8 min</p>
                </div>
                <ButtonLink class="self-start" variant="gold" href="/"
                    >Ler artigo completo</ButtonLink
                >
            </div>
            <div class="bg-navy-mid px-12 py-16 flex flex-col gap-6">
                <p class="dest">Direito Trabalhista</p>
                <h1 class="text-4xl font-serif text-text-light">
                    O que muda com a reforma trabalhista para contratos
                    intermitentes em 2024
                </h1>
                <p class="text-text-subtle">
                    Novas decisões do TST e alterações regulatórias mudam o
                    cenário para trabalhadores e empregadores que utilizam esse
                    modelo contratual.
                </p>
                <div class="flex items-center gap-6 my-6">
                    <div class="flex gap-2 items-center">
                        <span
                            class="rounded-full bg-navy p-3 font-serif text-text-light"
                            >CM</span
                        >
                        <p class="text-text-light">Dr. Carlos Mendes</p>
                    </div>
                    <span class="bg-text-subtle rounded-full w-1.5 h-1.5"
                    ></span>
                    <p class="text-text-subtle">15 jan 2024</p>
                    <span class="bg-text-subtle rounded-full w-1.5 h-1.5"
                    ></span>
                    <p class="text-text-subtle">8 min</p>
                </div>
                <ButtonLink class="self-start" variant="gold" href="/"
                    >Ler artigo completo</ButtonLink
                >
            </div>
        </div>
    </div>

    <!-- Artigos -->

    <div class="px-12 py-12">
        <div class="mx-auto w-fit">
            <h2 class="font-serif text-3xl text-navy mb-8">
                Oque <span class="italic text-gold">abrange</span> esta área
            </h2>

            <div class="grid grid-cols-[repeat(3,minmax(0,602px))] gap-0.5">
                {
                    articlesMock.map((a) => (
                        <CardArticle
                            author={a.author}
                            category={a.category}
                            date={a.date}
                            href={a.href}
                            readingTime={a.readingTime}
                            title={a.title}
                        />
                    ))
                }
            </div>
        </div>
    </div>
</Base>
