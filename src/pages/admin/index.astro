---

---

<!doctype html>
<html>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Painel — Mendes & Associados</title>
    </head>
    <body>
        <script is:inline>
            window.CMS_MANUAL_INIT = true;
        </script>

        <script
            is:inline
            src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>

        <script is:inline>
            CMS.init({
                config: {
                    local_backend: true,
                    backend: {
                        name: "git-gateway",
                        branch: "main",
                    },
                    media_folder: "public/images",
                    public_folder: "/images",
                    collections: [
                        {
                            name: "blog",
                            label: "Blog",
                            label_singular: "Post",
                            folder: "src/content/blog",
                            create: true,
                            slug: "{{slug}}",
                            fields: [
                                {
                                    label: "Título",
                                    name: "title",
                                    widget: "string",
                                },
                                {
                                    label: "Resumo",
                                    name: "excerpt",
                                    widget: "text",
                                },
                                {
                                    label: "Autor",
                                    name: "author",
                                    widget: "string",
                                },
                                {
                                    label: "Data",
                                    name: "date",
                                    widget: "datetime",
                                    format: "YYYY-MM-DD",
                                    date_format: "DD/MM/YYYY",
                                    time_format: false,
                                },
                                {
                                    label: "Categoria",
                                    name: "category",
                                    widget: "select",
                                    options: [
                                        { label: "Civil", value: "civil" },
                                        {
                                            label: "Trabalhista",
                                            value: "trabalhista",
                                        },
                                        {
                                            label: "Empresarial",
                                            value: "empresarial",
                                        },
                                        {
                                            label: "Imobiliário",
                                            value: "imobiliario",
                                        },
                                        { label: "Família", value: "familia" },
                                    ],
                                },
                                {
                                    label: "Destaque",
                                    name: "featured",
                                    widget: "boolean",
                                    default: false,
                                },
                                {
                                    label: "Tempo de leitura",
                                    name: "readTime",
                                    widget: "string",
                                    hint: "Ex: 5 min",
                                },
                                {
                                    label: "Conteúdo",
                                    name: "body",
                                    widget: "markdown",
                                },
                            ],
                        },
                    ],
                },
            });
        </script>
    </body>
</html>
